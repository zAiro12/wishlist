generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DISABLED
}

enum ItemStatus {
  DISPONIBILE
  PRENOTATO
  COMPRATO
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  emailVerified      Boolean    @default(false)
  givenName          String?
  familyName         String?
  avatarUrl          String?
  birthdate          String?    // YYYY-MM-DD
  birthdateConfirmed Boolean    @default(false)
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  bannedAt           DateTime?
  bannedReason       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  identities       UserIdentity[]
  groupMemberships GroupMember[]
  ownedGroups      Group[]             @relation("GroupOwner")
  wishlistItems    WishlistItem[]
  pushSubscriptions PushSubscription[]
  statusesSet      WishlistItemStatus[]
  auditActorOf     AdminAction[]       @relation("AdminActor")
  auditTargetOf    AdminAction[]       @relation("AdminTarget")
  giftBatchesPaid  GroupGiftBatch[]    @relation("GroupGiftBatchPaidBy")
  giftBatchesCreated GroupGiftBatch[]   @relation("GroupGiftBatchCreatedBy")
  giftBatchesClosed GroupGiftBatch[]    @relation("GroupGiftBatchClosedBy")
  giftSettlementsDebtor GroupGiftSettlement[] @relation("GroupGiftSettlementDebtor")
  giftSettlementsSettled GroupGiftSettlement[] @relation("GroupGiftSettlementSettledBy")

  @@index([email])
  @@index([status])
}

model UserIdentity {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // google | github | microsoft
  providerSub String   // provider's user ID
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerSub])
  @@index([userId])
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members GroupMember[]
  giftBatches GroupGiftBatch[]

  @@index([ownerId])
  @@index([deletedAt])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@index([removedAt])
}

model WishlistItem {
  id          String    @id @default(cuid())
  ownerId     String
  title       String
  description String?
  url         String?
  imageUrl    String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner  User                @relation(fields: [ownerId], references: [id])
  status WishlistItemStatus?

  @@index([ownerId])
  @@index([deletedAt])
}

model WishlistItemStatus {
  id            String     @id @default(cuid())
  itemId        String     @unique
  status        ItemStatus @default(DISPONIBILE)
  statusGroupId String?
  setByUserId   String?
  updatedAt     DateTime   @updatedAt
  version       Int        @default(0)

  item      WishlistItem @relation(fields: [itemId], references: [id])
  setByUser User?        @relation(fields: [setByUserId], references: [id])

  @@index([itemId])
  @@index([statusGroupId])
}

model PushSubscription {
  id                  String   @id @default(cuid())
  userId              String
  endpoint            String   @unique
  p256dh              String
  auth                String
  failedDeliveryCount Int      @default(0)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminAction {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  actor      User  @relation("AdminActor", fields: [actorId], references: [id])
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

model GroupGiftBatch {
  id               String   @id @default(cuid())
  groupId          String
  title            String
  note             String?
  totalAmountCents Int
  paidByUserId     String
  paidAt           DateTime
  beneficiaryIds   String[]
  createdByUserId  String
  closedAt         DateTime?
  closedByUserId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group       Group                @relation(fields: [groupId], references: [id])
  paidBy      User                 @relation("GroupGiftBatchPaidBy", fields: [paidByUserId], references: [id])
  createdBy   User                 @relation("GroupGiftBatchCreatedBy", fields: [createdByUserId], references: [id])
  closedBy    User?                @relation("GroupGiftBatchClosedBy", fields: [closedByUserId], references: [id])
  settlements GroupGiftSettlement[]

  @@index([groupId])
  @@index([paidByUserId])
  @@index([createdByUserId])
  @@index([closedAt])
  @@index([paidAt])
}

model GroupGiftSettlement {
  id              String   @id @default(cuid())
  batchId         String
  debtorUserId    String
  amountCents     Int
  settledAt       DateTime?
  settledByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batch     GroupGiftBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  debtor    User           @relation("GroupGiftSettlementDebtor", fields: [debtorUserId], references: [id])
  settledBy User?          @relation("GroupGiftSettlementSettledBy", fields: [settledByUserId], references: [id])

  @@index([batchId])
  @@index([debtorUserId])
  @@index([settledAt])
}
